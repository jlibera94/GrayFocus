{
  "manifest_version": 3,
  "name": "GrayFocus",
  "version": "1.0.0",
  "description": "Make distracting websites grayscale, remembering your preference for each site.",
  "icons": {
    "16": "icons/icon_16.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {"default_popup": "popup.html", "default_title": "GrayFocus", "default_icon": "icons/icon_16.png"},
  "content_scripts": [{"matches": ["<all_urls>"], "css": ["grayscale.css"], "js": ["content.js"], "run_at": "document_start"}]
}
